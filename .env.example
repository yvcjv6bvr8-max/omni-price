# ============ 淘宝联盟（TOP 开放平台）============
# https://open.taobao.com/  新建应用后获得
TAOBAO_APP_KEY=
TAOBAO_APP_SECRET=
# 淘宝联盟媒体备案对应的推广位 PID（mm_xxx_xxx_xxx）
TAOBAO_ADZONE_ID=

# ============ 京东联盟（JOS 开放平台）============
# https://jos.jd.com/  创建应用后获得
JD_APP_KEY=
JD_APP_SECRET=
# 三段式推广位：unionId_siteId_adzoneId
JD_UNION_ID=
JD_ADZONE_ID=

# ============ 多多进宝（多多客开放平台）============
# https://open.pinduoduo.com/  创建应用后获得
PDD_CLIENT_ID=
PDD_CLIENT_SECRET=
PDD_PID=

# ============ 第三方聚合兜底（零门槛，可选）============
# 大淘客 https://openapi.dataoke.com/
DATAOKE_APP_KEY=
DATAOKE_APP_SECRET=
# 好单库 https://www.haodanku.com/openapi/
HAODANKU_API_KEY=

# ============ 本地服务 ============
OMNI_PRICE_DB=sqlite:///./data/omniprice.db
OMNI_PRICE_HOST=127.0.0.1
OMNI_PRICE_PORT=8790
